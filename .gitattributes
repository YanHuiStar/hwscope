# Force LF line endings for text files on all platforms (v1.47.1)
# - .sh/.conf/.md/.awk/.txt: Linux 侧消费，必须 LF（CRLF 会破坏 bash/awk/grep/diff）
# - .bat: cmd 按 CRLF 解析，强制 CRLF 防 LF 破坏（AGENTS.md v1.43.2 教训）
# - .ps1: 不强制 EOL（PowerShell 兼容两者，关键在 UTF-8 BOM，见 AGENTS.md）
*.sh   text eol=lf
*.conf text eol=lf
*.md   text eol=lf
*.awk  text eol=lf
*.txt  text eol=lf
*.bat  text eol=crlf
.gitignore text eol=lf
LICENSE text eol=lf
